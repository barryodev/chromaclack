{
  "name": "tauri-vercel-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@repo/frontend",
    "dev:desktop": "pnpm --filter @repo/desktop tauri dev",
    "dev:android": "pnpm --filter @repo/desktop tauri android dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@repo/frontend",
    "build:desktop": "pnpm --filter @repo/desktop tauri build",
    "check": "turbo run check",
    "lint": "eslint .",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "test:rust": "cargo test --workspace",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm lint:rust && pnpm test:rust && pnpm build",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.20.0"
  }
}
