{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Greeter",
  "version": "0.1.0",
  "identifier": "com.example.greeter",
  "build": {
    "beforeDevCommand": "pnpm --filter @repo/frontend dev",
    "beforeBuildCommand": "pnpm --filter @repo/frontend build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Greeter",
        "width": 900,
        "height": 640,
        "minWidth": 420,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
